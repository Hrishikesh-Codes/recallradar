# Copy to .env for local overrides. Never commit real values; production secrets live in
# Vercel / Hugging Face / GitHub Actions settings.

# local | test | production
ENVIRONMENT=local
# Defaults to the docker compose database. Neon URLs (postgres://...) are accepted as-is.
DATABASE_URL=postgresql+psycopg://recallradar:recallradar@localhost:5432/recallradar
# Optional: embeddings in another database (production uses a second Neon project).
VECTOR_DATABASE_URL=
# Tests create throwaway databases on this server; never point it at production.
TEST_DATABASE_URL=postgresql+psycopg://recallradar:recallradar@localhost:5432/recallradar
LOG_LEVEL=INFO
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000
# Optional: raises openFDA's daily request limit (https://open.fda.gov/apis/authentication/).
OPENFDA_API_KEY=
# Optional: error tracking.
SENTRY_DSN=
# Shared with the web server (its API_TOKEN_SECRET); enables account endpoints. 32+ characters.
API_TOKEN_SECRET=
# Public web address, used in alert emails.
WEB_URL=http://localhost:3000
# Alert emails. Locally: Mailpit from docker compose (inbox at http://localhost:8025).
SMTP_URL=smtp://localhost:1025
MAIL_FROM=RecallRadar <alerts@localhost>
# Web Push (VAPID). Generate a pair once; the public key goes to the web app as
# NEXT_PUBLIC_VAPID_PUBLIC_KEY.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@example.com
