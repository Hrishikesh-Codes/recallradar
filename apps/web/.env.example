# Copy to .env.local for local development. Never commit real values; production values live in
# the Vercel project settings.

# The API (FastAPI). Browsers call it directly.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Postgres, for Better Auth's tables (plain postgres:// URL; Neon's pooled URL in production).
DATABASE_URL=postgresql://recallradar:recallradar@localhost:5432/recallradar
# Better Auth: this site's public URL, and a random secret (openssl rand -base64 32).
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
# Shared with the API (its API_TOKEN_SECRET): signs the short-lived tokens for signed-in calls.
API_TOKEN_SECRET=
# Sign-in emails. Locally: Mailpit from docker compose (inbox at http://localhost:8025).
SMTP_URL=smtp://localhost:1025
MAIL_FROM=RecallRadar <sign-in@localhost>
# Web Push: the public half of the VAPID key pair (the jobs hold the private half).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
