{
  "components": {
    "schemas": {
      "Accepted": {
        "properties": {
          "status": {
            "const": "accepted",
            "default": "accepted",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "Accepted",
        "type": "object"
      },
      "CheckInput": {
        "properties": {
          "type": {
            "enum": [
              "text",
              "link",
              "barcode"
            ],
            "title": "Type",
            "type": "string"
          },
          "value": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Value",
            "type": "string"
          }
        },
        "required": [
          "type",
          "value"
        ],
        "title": "CheckInput",
        "type": "object"
      },
      "CheckRequest": {
        "properties": {
          "input": {
            "$ref": "#/components/schemas/CheckInput"
          },
          "purchase_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Overrides a date found in the input.",
            "title": "Purchase Date"
          }
        },
        "required": [
          "input"
        ],
        "title": "CheckRequest",
        "type": "object"
      },
      "CheckResponse": {
        "properties": {
          "coverage": {
            "$ref": "#/components/schemas/Coverage"
          },
          "id": {
            "description": "Quote this when sending feedback on the result.",
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "matches": {
            "items": {
              "$ref": "#/components/schemas/MatchOut"
            },
            "title": "Matches",
            "type": "array"
          },
          "notes": {
            "items": {
              "type": "string"
            },
            "title": "Notes",
            "type": "array"
          },
          "query": {
            "$ref": "#/components/schemas/QueryOut"
          },
          "related": {
            "items": {
              "$ref": "#/components/schemas/MatchOut"
            },
            "title": "Related",
            "type": "array"
          },
          "verdict": {
            "$ref": "#/components/schemas/Tier"
          }
        },
        "required": [
          "id",
          "verdict",
          "query",
          "matches",
          "related",
          "coverage",
          "notes"
        ],
        "title": "CheckResponse",
        "type": "object"
      },
      "Coverage": {
        "properties": {
          "checked": {
            "items": {
              "$ref": "#/components/schemas/SourceCoverage"
