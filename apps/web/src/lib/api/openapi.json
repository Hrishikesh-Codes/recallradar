          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "description": "Rate limited; see Retry-After."
          }
        },
        "summary": "Check Product",
        "tags": [
          "check"
        ]
      }
    },
