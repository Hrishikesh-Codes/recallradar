{
  "components": {
    "schemas": {
      "Environment": {
        "enum": [
          "local",
          "test",
          "production"
        ],
        "title": "Environment",
        "type": "string"
      },
      "Liveness": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "Liveness",
        "type": "object"
      },
      "Meta": {
        "properties": {
          "environment": {
            "$ref": "#/components/schemas/Environment"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "version",
          "environment"
        ],
        "title": "Meta",
        "type": "object"
      },
      "Readiness": {
        "properties": {
          "database": {
            "title": "Database",
            "type": "boolean"
          },
          "status": {
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "database"
        ],
        "title": "Readiness",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "RecallRadar API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "description": "The process is up. Never touches the database, so it stays cheap to poll.",
        "operationId": "liveness_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Liveness"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness",
        "tags": [
          "health"
        ]
      }
    },
    "/readyz": {
      "get": {
        "operationId": "readiness_readyz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Readiness",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/meta": {
      "get": {
        "operationId": "meta_v1_meta_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Meta"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Meta",
        "tags": [
          "health"
        ]
      }
    }
  }
}
