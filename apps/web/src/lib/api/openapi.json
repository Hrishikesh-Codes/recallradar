    "/v1/check": {
      "post": {
        "description": "Check one product (description, product link, barcode, or VIN) against every recall.\n\nNo account needed. Nothing about the product is stored, only that a check happened.",
        "operationId": "check_product_v1_check_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckRequest"
              }
            }
          },
          "required": true
