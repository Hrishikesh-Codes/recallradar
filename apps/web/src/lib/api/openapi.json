              }
            ],
            "title": "Updated At"
          }
        },
        "required": [
          "checked",
          "not_covered",
          "recalls_checked",
          "updated_at"
        ],
        "title": "Coverage",
        "type": "object"
      },
      "Environment": {
        "enum": [
          "local",
          "test",
          "production"
        ],
        "title": "Environment",
        "type": "string"
      },
      "FeedbackRequest": {
        "properties": {
          "check_id": {
            "format": "uuid",
