# /opt/recallradar/.env on the VM (chmod 600). Secrets live only here, never in the repo.
# update.sh won't deploy while any value is still CHANGE_ME.

# The API's public name. Either a subdomain you own with an A record pointing at this VM
# (e.g. recallradar-api.example.com), or <the VM's IP with dashes>.sslip.io (no DNS needed).
API_DOMAIN=CHANGE_ME
# Neon's pooled connection string.
DATABASE_URL=CHANGE_ME
# Same value as the web app's API_TOKEN_SECRET (openssl rand -hex 32).
API_TOKEN_SECRET=CHANGE_ME
# The web app's URL, e.g. https://recallradar.vercel.app
CORS_ORIGINS=CHANGE_ME
ENVIRONMENT=production
# Optional.
SENTRY_DSN=
